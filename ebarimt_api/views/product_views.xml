<odoo>
    <!-- VAT Code View -->
    <record id="view_vat_code_form" model="ir.ui.view">
        <field name="name">view.vat.code.form</field>
        <field name="model">product.vat.code</field>
        <field name="arch" type="xml">
            <form string="VAT Code">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="name" /></h2>
                    </div>
                    <group>
                        <field name="tax_type" />
                        <field name="label" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_vat_code_list" model="ir.ui.view">
        <field name="name">view.vat.code.list</field>
        <field name="model">product.vat.code</field>
        <field name="arch" type="xml">
        <list string="VAT Code">
            <field name="tax_type" />
            <field name="name" />
            <field name="label" />
        </list>
        </field>
    </record>

    <!-- Classification Code View -->
    <record id="view_classification_code_form" model="ir.ui.view">
        <field name="name">view.classification.code.form</field>
        <field name="model">product.classification.code</field>
        <field name="arch" type="xml">
            <form string="Classification Code">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="name" /></h2>
                    </div>
                    <group>
                        <field name="label" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_classification_code_list" model="ir.ui.view">
        <field name="name">view.classification.code.list</field>
        <field name="model">product.classification.code</field>
        <field name="arch" type="xml">
            <list string="VAT Code">
                <field name="name" />
                <field name="label" />
            </list>
        </field>
    </record>


    <!-- eBarimt codes on the product form. vat_code_id (taxProductCode) is
         required by PosAPI for products sold VAT free or at VAT 0%. -->
    <record id="product_template_form_view_inherit_ss_ebarimt_api" model="ir.ui.view">
        <field name="name">product_template_form_view.inherit.ss_ebarimt_api</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="eBarimt" name="ebarimt_configuration"
                      groups="account.group_account_invoice,point_of_sale.group_pos_manager">
                    <group>
                        <group>
                            <field name="vat_classification_id" />
                            <field name="vat_code_id" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
