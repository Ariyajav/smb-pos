<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_offering.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <div t-if="order.offering_from" class="pos-offering-receipt pt-2" style="border-top: 1px dashed #999;">
                <div>Хэнээс: <t t-esc="order.offering_from"/></div>
                <div t-if="order.offering_family_size">Ам бүл: <t t-esc="order.offering_family_size"/></div>
                <div t-if="order.offering_day">Айлдах өдөр: <t t-esc="order.offering_day"/></div>
            </div>
        </xpath>
    </t>
</templates>
