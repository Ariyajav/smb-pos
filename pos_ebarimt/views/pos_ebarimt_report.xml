<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Receipt template -->
    <template id="report_pos_ebarimt" name="POS eBarimt Receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" style="font-family: 'DejaVu Sans Mono', monospace; font-size: 12px;">
                    <!-- Тусгай receipt style -->
                    <style>
                        .receipt-content { width: 300px; margin: 0 auto; }
                        .text-center { text-align: center; }
                        .text-right, .text-end { text-align: right; }
                        hr { border-top: 1px dashed #000; }
                    </style>
                    
                    <div class="receipt-content">
                        <t t-set="ebarimt" t-value="o.ebarimt_report_data()"/>
                        <t t-set="receipt" t-value="ebarimt['receipt']"/>

                        <!-- Header -->
                        <div class="text-center">
                            <h3 style="margin: 0;"><t t-esc="o.company_id.name"/></h3>
                            <div t-if="ebarimt['seller_tin']">ТТД: <t t-esc="ebarimt['seller_tin']"/></div>
                            <div><t t-esc="o.session_id.config_id.name"/></div>
                        </div>

                        <hr/>

                        <!-- Order Info -->
                        <div>
                            <strong>Захиалга:</strong> <t t-esc="o.name"/><br/>
                            <strong>Огноо:</strong> <t t-esc="o.date_order" t-options='{"widget": "datetime", "format": "yyyy-MM-dd HH:mm"}'/>
                            <t t-if="o.partner_id and not ebarimt['buyer_tin']"><br/><strong>Харилцагч:</strong> <t t-esc="o.partner_id.name"/></t>
                            <t t-if="ebarimt['buyer_tin']">
                                <br/><strong>Худалдан авагч:</strong>
                                <t t-if="ebarimt['buyer_name']"><t t-esc="ebarimt['buyer_name']"/>,</t>
                                ТТД: <t t-esc="ebarimt['buyer_tin']"/>
                            </t>
                        </div>

                        <hr/>

                        <!-- Items: name on its own line, then qty x unit price and the line total.
                             After a partial return only the kept items are shown. -->
                        <div t-if="ebarimt['replaced']" style="margin-bottom: 4px;">
                            <strong>Хэсэгчилсэн буцаалтын дараах баримт</strong>
                        </div>
                        <table width="100%">
                            <t t-foreach="ebarimt['lines']" t-as="item">
                                <tr><td colspan="2" style="word-break: break-word;"><t t-esc="item['name']"/></td></tr>
                                <tr>
                                    <td style="padding-left: 8px;"><t t-esc="item['qty']"/> x <t t-esc="item['unit']"/></td>
                                    <td class="text-right" style="white-space: nowrap;"><t t-esc="item['amount']"/></td>
                                </tr>
                            </t>
                        </table>

                        <hr/>

                        <!-- Totals -->
                        <table width="100%">
                            <tr>
                                <td><strong>Нийт:</strong></td>
                                <td class="text-right" style="white-space: nowrap;"><strong><t t-esc="ebarimt['total']"/> ₮</strong></td>
                            </tr>
                            <tr t-if="receipt">
                                <td>НӨАТ:</td>
                                <td class="text-right" style="white-space: nowrap;"><t t-esc="ebarimt['vat']"/> ₮</td>
                            </tr>
                            <tr t-if="ebarimt['city_tax']">
                                <td>НХАТ:</td>
                                <td class="text-right" style="white-space: nowrap;"><t t-esc="ebarimt['city_tax']"/> ₮</td>
                            </tr>
                        </table>

                        <!-- eBarimt Section -->
                        <t t-if="receipt">
                            <hr/>
                            <div style="word-break: break-all;"><strong>ДДТД:</strong> <t t-esc="receipt.bill_id"/></div>

                            <div t-if="ebarimt['qr']" class="text-center" style="margin: 10px 0;">
                                <img t-att-src="'data:image/png;base64,%s' % ebarimt['qr']" style="width: 150px; height: 150px;"/>
                            </div>

                            <div t-if="receipt.lottery" class="text-center" style="border: 2px solid #000; padding: 8px; margin: 10px 0;">
                                <strong>СУГАЛААНЫ ДУГААР</strong><br/>
                                <span style="font-size: 18px; font-weight: bold;"><t t-esc="receipt.lottery"/></span>
                            </div>

                            <p class="text-center" style="font-size: 10px;">
                                ebarimt.mn сайтаар баримтаа шалгана уу
                            </p>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Report action - Paper format БАЙХГҮЙ -->
    <record id="action_report_pos_ebarimt" model="ir.actions.report">
        <field name="name">POS eBarimt Receipt</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_ebarimt.report_pos_ebarimt</field>
        <field name="report_file">POS_eBarimt_Receipt</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>