<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_ebarimt.EbarimtConfirmPopup">
        <Dialog title="props.title" size="'md'">
            <div class="popup-ebarimt-new">
                <div t-if="props.body" class="mb-2 text-muted" t-esc="props.body"/>

                <!-- Баримтын төрөл сонгох -->
                <div class="mb-3">
                    <h4 class="mb-2 fs-5 eb-heading">Баримтын төрөл:</h4>

                    <!-- Хувь хүн -->
                    <div class="mb-2 p-2 rounded-3 eb-choice eb-choice-individual" t-att-class="{'eb-active': state.receiptType === 'individual'}">
                        <label class="d-flex align-items-center m-0 w-100" style="cursor: pointer;"
                               t-on-click="() => this.changeReceiptType('individual')">
                            <input type="radio" name="receiptType" value="individual"
                                   class="form-check-input me-2"
                                   t-att-checked="state.receiptType === 'individual'"/>
                            <strong class="eb-choice-label">👤 Хувь хүн</strong>
                        </label>
                    </div>

                    <!-- Байгууллага -->
                    <div class="mb-2 p-2 rounded-3 eb-choice eb-choice-organization" t-att-class="{'eb-active': state.receiptType === 'organization'}">
                        <label class="d-flex align-items-center m-0 w-100" style="cursor: pointer;"
                               t-on-click="() => this.changeReceiptType('organization')">
                            <input type="radio" name="receiptType" value="organization"
                                   class="form-check-input me-2"
                                   t-att-checked="state.receiptType === 'organization'"/>
                            <strong class="eb-choice-label">🏢 Байгууллага</strong>
                        </label>
                    </div>
                </div>

                <!-- Customer Info харуулах -->
                <div t-if="state.hasCustomer" class="mb-3 p-2 rounded eb-note">
                    <div class="small">
                        <strong>📋 Сонгосон харилцагч:</strong> <t t-esc="state.customerName"/>
                    </div>
                    <div t-if="state.customerTin" class="small mt-1">
                        <strong>🆔 ТТД:</strong> <t t-esc="state.customerTin"/>
                    </div>
                </div>

                <!-- CustomerTin Input - зөвхөн байгууллага сонгосон үед -->
                <div t-if="state.receiptType === 'organization'" class="mb-2">
                    <label class="d-block mb-2 fw-bold small eb-heading">
                        🆔 Байгууллагын регистр:
                    </label>

                    <div t-if="state.hasCustomer and state.customerTin"
                         class="mb-2 p-2 rounded eb-found">
                        <div class="small mb-1">Харилцагчаас автоматаар авагдсан:</div>
                        <div class="font-monospace fw-bold"><t t-esc="state.customerTin"/></div>
                    </div>

                    <input type="text"
                           class="form-control font-monospace"
                           t-model="state.manualCustomerTin"
                           t-on-input="onManualTinChange"
                           placeholder="Регистр энд оруулна уу"
                           maxlength="20"/>
                    <div class="small text-muted mt-1">
                        <t t-if="state.hasCustomer and state.customerTin">
                            💡 Хоосон байвал харилцагчийн ТТД ашиглана
                        </t>
                        <t t-else="">
                            💡 Байгууллагын регистр бүрэн оруулна уу
                        </t>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg lh-lg confirm" t-on-click="onConfirm">✅ Илгээх</button>
                <button class="btn btn-secondary btn-lg lh-lg cancel" t-on-click="onCancel">❌ Цуцлах</button>
            </t>
        </Dialog>
    </t>
</templates>
